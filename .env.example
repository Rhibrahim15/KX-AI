# KX Sanctuary OS — local development environment
# Copy to .env. Never commit real credentials.

NODE_ENV=development
PORT=7860

# Browser origins allowed to call the API. Comma-separated; never use *.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Required for production API access. Keep this secret.
# Local development may leave it empty.
API_AUTH_TOKEN=

# Configure at least one supported provider.
LLM_PROVIDER_ORDER=groq,openrouter,cerebras,mistral
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=KX Sanctuary OS
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Persistence milestone (Prisma + PostgreSQL, not yet wired into chat).
DATABASE_URL=

# Optional Telegram voice-note integration.
TELEGRAM_BOT_TOKEN=

# Next.js web-to-API proxy (set on the web host only)
# KX_AI_BACKEND_TOKEN must equal API_AUTH_TOKEN on the backend.
KX_AI_BACKEND_URL=
KX_AI_BACKEND_TOKEN=

# Private web access gate (required for production web deployments)
# Use a long unique password and a separate random secret (minimum 32 characters).
KX_WEB_ACCESS_PASSWORD=
KX_WEB_SESSION_SECRET=
